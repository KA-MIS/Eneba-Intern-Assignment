# Copy to backend/.env locally or configure these in the backend hosting environment.
# NEVER commit backend/.env or real credentials.

DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REFERENCE
DB_PASSWORD=REPLACE_ME

# Supabase Auth: use the same project URL and publishable key as the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
